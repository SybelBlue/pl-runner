{
  "name": "@sybelblue/prairielearn-runner",
  "version": "0.2.0",
  "description": "Persistent PrairieLearn host manager with a TUI and headless CLI.",
  "homepage": "https://github.com/SybelBlue/pl-runner#readme",
  "bugs": {
    "url": "https://github.com/SybelBlue/pl-runner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SybelBlue/pl-runner.git"
  },
  "license": "ISC",
  "author": "Serena Caraco",
  "type": "module",
  "bin": {
    "prairielearn-runner": "bin/pl",
    "pl": "bin/pl"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "bin",
    "dist",
    "functions",
    "completions",
    "docs"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build",
    "test": "npm run build && tsx --test test/*.test.ts test/*.test.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p test/tsconfig.json",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.2",
    "ink-testing-library": "4.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
